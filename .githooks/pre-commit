#!/bin/sh
# Bloqueia commit com segredo. Ative uma vez por clone:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks não encontrado — instale (winget install Gitleaks.Gitleaks) ou o commit segue sem varredura." >&2
  exit 0
fi
exec gitleaks protect --staged --redact --verbose
